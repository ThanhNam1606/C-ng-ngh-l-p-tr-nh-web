<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Quản trị BanXePKL</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <style>
        body { background: #f4f6f9; }
        .admin-sidebar { min-height: 100vh; background: #1a1a2e; }
        .admin-sidebar a { color: #ccc; display: block; padding: 12px 20px; text-decoration: none; }
        .admin-sidebar a:hover { background: #e63946; color: #fff; }
    </style>
</head>
<body>
    <div class="d-flex">
        <div class="admin-sidebar" style="width: 240px;">
            <h5 class="text-white text-center py-3 mb-0">🏍️ Admin Panel</h5>
            <a asp-controller="AdminDashboard" asp-action="Index">📊 Thống kê</a>
            <a asp-controller="XeAdmin" asp-action="Index">🏍️ Quản lý xe</a>
            <a asp-controller="DonHangAdmin" asp-action="Index">📦 Đơn hàng</a>
            <a asp-controller="NguoiDungAdmin" asp-action="Index">👤 Khách hàng</a>
            <hr class="text-secondary" />
            <a asp-controller="Home" asp-action="Index">🔙 Về trang chủ</a>
        </div>
        <div class="flex-grow-1 p-4">
            @if (TempData["ThongBao"] != null)
            {
                <div class="alert alert-success">@TempData["ThongBao"]</div>
            }
            @RenderBody()
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
