@model BanXePKL_Project.Models.DonHang
@{
    ViewData["Title"] = $"Chi tiết đơn hàng #{Model.DonHangId}";
}

<div class="container my-4">
    <h3 class="mb-4">Chi tiết đơn hàng #@Model.DonHangId</h3>

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <p><strong>Ngày đặt:</strong> @Model.NgayDat.ToString("dd/MM/yyyy HH:mm")</p>
            <p><strong>Địa chỉ giao hàng:</strong> @Model.DiaChiGiao</p>
            <p><strong>Số điện thoại:</strong> @Model.SoDienThoaiNhan</p>
            <p><strong>Phương thức thanh toán:</strong> @Model.PhuongThucThanhToan</p>
            <p class="mb-0"><strong>Trạng thái:</strong> @Model.TrangThaiDonHang</p>
        </div>
    </div>

    <table class="table align-middle">
        <thead>
            <tr>
                <th>Xe</th>
                <th>Số lượng</th>
                <th>Đơn giá</th>
                <th>Thành tiền</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var ct in Model.ChiTietDonHang)
            {
                <tr>
                    <td>@ct.Xe.TenXe</td>
                    <td>@ct.SoLuong</td>
                    <td>@ct.DonGia.ToString("N0") đ</td>
                    <td class="fw-bold text-danger">@ct.ThanhTien.ToString("N0") đ</td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr>
                <th colspan="3" class="text-end">Tổng cộng</th>
                <th class="text-danger">@Model.TongTien.ToString("N0") đ</th>
            </tr>
        </tfoot>
    </table>

    <a asp-action="LichSu" class="btn btn-secondary">&larr; Quay lại lịch sử đơn hàng</a>
</div>
