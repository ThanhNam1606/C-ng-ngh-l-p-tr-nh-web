@model List<BanXePKL_Project.Models.Xe>
@{
    ViewData["Title"] = "Trang chủ";
    var danhMuc = ViewBag.DanhMuc as List<BanXePKL_Project.Models.DanhMuc>;
}

<!-- ===================== BANNER ===================== -->
<div class="bg-dark text-white text-center py-5 mb-4">
    <div class="container">
        <h1 class="fw-bold">XE PHÂN KHỐI LỚN CHÍNH HÃNG</h1>
        <p class="lead">Đam mê tốc độ - Chất lượng hàng đầu - Giá tốt nhất thị trường</p>
        <a asp-controller="Xe" asp-action="Index" class="btn btn-danger btn-lg mt-2">Khám phá ngay</a>
    </div>
</div>

<div class="container">

    <!-- ===================== DANH MỤC NHANH ===================== -->
    @if (danhMuc != null && danhMuc.Any())
    {
        <div class="d-flex flex-wrap gap-2 justify-content-center mb-5">
            @foreach (var dm in danhMuc)
            {
                <a asp-controller="Xe" asp-action="Index" asp-route-danhMucId="@dm.DanhMucId"
                   class="btn btn-outline-dark rounded-pill px-4">
                    @dm.TenDanhMuc
                </a>
            }
        </div>
    }

    <!-- ===================== XE NỔI BẬT ===================== -->
    <h4 class="mb-3">Xe mới về</h4>

    @if (!Model.Any())
    {
        <p class="text-muted">Chưa có xe nào được thêm vào hệ thống.</p>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4 mb-5">
            @foreach (var xe in Model)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm">
                        <img src="@(xe.AnhDaiDien ?? "/images/no-image.png")"
                             class="card-img-top" style="height:220px;object-fit:cover;"
                             alt="@xe.TenXe" />
                        <div class="card-body d-flex flex-column">
                            <h6 class="card-title mb-1">@xe.TenXe</h6>
                            <p class="text-muted small mb-1">@xe.HangXe?.TenHang &bull; @xe.PhanKhoi cc</p>
                            <p class="fw-bold text-danger mb-2">@xe.GiaBan.ToString("N0") đ</p>
                            <a asp-controller="Xe" asp-action="Details" asp-route-id="@xe.XeId"
                               class="btn btn-outline-dark mt-auto">Xem chi tiết</a>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="text-center mb-5">
            <a asp-controller="Xe" asp-action="Index" class="btn btn-dark px-4">Xem tất cả xe</a>
        </div>
    }
</div>
