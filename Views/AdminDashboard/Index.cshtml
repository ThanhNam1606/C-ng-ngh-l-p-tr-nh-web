@using System.Linq
@model BanXePKL_Project.Models.ThongKeViewModel
@{
    ViewData["Title"] = "Thống kê";
    Layout = "_AdminLayout";
}

<h3 class="mb-4">Tổng quan hệ thống</h3>

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card text-white bg-danger shadow-sm">
            <div class="card-body">
                <div class="small">Tổng doanh thu</div>
                <div class="fs-4 fw-bold">@Model.TongDoanhThu.ToString("N0") đ</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-white bg-dark shadow-sm">
            <div class="card-body">
                <div class="small">Tổng đơn hàng</div>
                <div class="fs-4 fw-bold">@Model.TongDonHang</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-white bg-secondary shadow-sm">
            <div class="card-body">
                <div class="small">Khách hàng</div>
                <div class="fs-4 fw-bold">@Model.TongKhachHang</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-white shadow-sm" style="background:#495057;">
            <div class="card-body">
                <div class="small">Số mẫu xe</div>
                <div class="fs-4 fw-bold">@Model.TongXe</div>
            </div>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-8">
        <div class="card shadow-sm">
            <div class="card-header">Doanh thu 6 tháng gần nhất</div>
            <div class="card-body">
                <canvas id="bieuDoDoanhThu" height="100"></canvas>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card shadow-sm">
            <div class="card-header">Top 5 xe bán chạy</div>
            <ul class="list-group list-group-flush">
                @if (!Model.XeBanChay.Any())
                {
                    <li class="list-group-item text-muted">Chưa có dữ liệu bán hàng.</li>
                }
                @foreach (var xe in Model.XeBanChay)
                {
                    <li class="list-group-item d-flex justify-content-between">
                        <span>@xe.TenXe</span>
                        <span class="badge bg-danger">@xe.SoLuongBan</span>
                    </li>
                }
            </ul>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        const ctx = document.getElementById('bieuDoDoanhThu');
        new Chart(ctx, {
            type: 'bar',
            data: {
                labels: @Html.Raw(Json.Serialize(Model.DoanhThuTheoThang.Select(x => x.Thang))),
                datasets: [{
                    label: 'Doanh thu (VNĐ)',
                    data: @Html.Raw(Json.Serialize(Model.DoanhThuTheoThang.Select(x => x.DoanhThu))),
                    backgroundColor: '#e63946'
                }]
            },
            options: { responsive: true }
        });
    </script>
}
