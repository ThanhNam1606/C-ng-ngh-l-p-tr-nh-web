@model BanXePKL_Project.Models.NguoiDung
@{
    ViewData["Title"] = "Thông tin cá nhân";
}

<div class="container my-4" style="max-width:600px;">
    <h3 class="mb-4">Thông tin cá nhân</h3>

    @if (TempData["ThongBao"] != null)
    {
        <div class="alert alert-success">@TempData["ThongBao"]</div>
    }

    <form asp-controller="TaiKhoan" asp-action="ThongTin" method="post">
        <input type="hidden" asp-for="UserId" />

        <div class="mb-3">
            <label class="form-label">Họ tên</label>
            <input asp-for="HoTen" class="form-control" />
        </div>

        <div class="mb-3">
            <label class="form-label">Email</label>
            <input asp-for="Email" class="form-control" disabled />
            <small class="text-muted">Email không thể thay đổi.</small>
        </div>

        <div class="mb-3">
            <label class="form-label">Số điện thoại</label>
            <input asp-for="SoDienThoai" class="form-control" />
        </div>

        <div class="mb-3">
            <label class="form-label">Địa chỉ</label>
            <input asp-for="DiaChi" class="form-control" />
        </div>

        <button type="submit" class="btn btn-danger">Lưu thay đổi</button>
        <a asp-action="DoiMatKhau" class="btn btn-outline-secondary">Đổi mật khẩu</a>
    </form>

    <hr class="my-4" />

    <div class="d-flex gap-2">
        <a asp-controller="DonHang" asp-action="LichSu" class="btn btn-outline-dark">Đơn hàng của tôi</a>
        <a asp-controller="GioHang" asp-action="Index" class="btn btn-outline-dark">Giỏ hàng</a>
    </div>
</div>
