@model List<BanXePKL_Project.Models.Xe>
@{
    ViewData["Title"] = "Quản lý xe";
    Layout = "_AdminLayout";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0">Quản lý xe</h3>
    <a asp-action="Create" class="btn btn-danger">+ Thêm xe mới</a>
</div>

<form method="get" class="mb-3 d-flex gap-2" style="max-width:400px;">
    <input type="text" name="keyword" class="form-control" placeholder="Tìm theo tên xe..." value="@ViewBag.Keyword" />
    <button type="submit" class="btn btn-outline-dark">Tìm</button>
</form>

<div class="card shadow-sm">
    <table class="table mb-0 align-middle">
        <thead class="table-light">
            <tr>
                <th>Ảnh</th>
                <th>Tên xe</th>
                <th>Hãng</th>
                <th>Danh mục</th>
                <th>Giá bán</th>
                <th>Tồn kho</th>
                <th>Trạng thái</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var xe in Model)
            {
                <tr>
                    <td>
                        <img src="@(xe.AnhDaiDien ?? "/images/no-image.png")"
                             style="width:60px;height:60px;object-fit:cover;" class="rounded" />
                    </td>
                    <td>@xe.TenXe</td>
                    <td>@xe.HangXe?.TenHang</td>
                    <td>@xe.DanhMuc?.TenDanhMuc</td>
                    <td>@xe.GiaBan.ToString("N0") đ</td>
                    <td>@xe.SoLuongTon</td>
                    <td>
                        @if (xe.TrangThai)
                        {
                            <span class="badge bg-success">Đang bán</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Ngừng bán</span>
                        }
                    </td>
                    <td class="d-flex gap-1">
                        <a asp-action="Edit" asp-route-id="@xe.XeId" class="btn btn-sm btn-outline-primary">Sửa</a>
                        <form asp-action="Delete" asp-route-id="@xe.XeId" method="post"
                              onsubmit="return confirm('Ẩn xe này khỏi cửa hàng?');">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Ẩn</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
